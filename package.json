{
  "name": "durable-agent-runtime",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "test:integration": "turbo run test:integration",
    "dev": "turbo run start:dev",
    "format": "prettier --write \"apps/**/src/**/*.ts\" \"packages/**/src/**/*.ts\"",
    "db:generate": "npm run db:generate --workspace @dar/api",
    "db:migrate": "npm run db:migrate --workspace @dar/api",
    "db:studio": "npm run db:studio --workspace @dar/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.5.0"
  },
  "packageManager": "npm@11.12.1"
}
