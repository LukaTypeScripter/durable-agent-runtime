# Copy to .env and fill in. Every variable is validated at boot by
# src/config/env.schema.ts — the process refuses to start on a bad value.
# Values shown are the built-in defaults unless marked REQUIRED.

# --- app ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public address of this runtime; used to build run and approval links.
PUBLIC_BASE_URL=http://localhost:3000

# --- postgres (journal + state) ----------------------------------------------
# REQUIRED
DATABASE_URL=postgres://postgres:postgres@localhost:5432/durable_agent_runtime
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- redis / bullmq (turn scheduling) ----------------------------------------
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=dar
WORKER_CONCURRENCY=8
# Retries for a crashed turn before the run is marked failed.
TURN_MAX_ATTEMPTS=5
TURN_BACKOFF_MS=2000

# --- model providers ---------------------------------------------------------
# At least one API key is REQUIRED.
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5
LLM_REQUEST_TIMEOUT_MS=120000
LLM_MAX_RETRIES=3

# --- mcp (tool source) -------------------------------------------------------
MCP_CONNECT_TIMEOUT_MS=10000
MCP_CALL_TIMEOUT_MS=60000

# --- auth / multi-tenancy ----------------------------------------------------
# REQUIRED, min 32 chars. Pepper mixed into API key hashes; rotating it
# invalidates every issued key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_PEPPER=

# --- outbound webhooks -------------------------------------------------------
# REQUIRED, min 32 chars. Signs the callback POST so receivers can verify it.
WEBHOOK_SIGNING_SECRET=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=6

# --- default per-run budgets (an agent may lower these, never raise them) -----
RUN_MAX_TURNS=25
RUN_MAX_TOOL_CALLS=100
RUN_MAX_TOKENS=500000
RUN_MAX_COST_USD=5
# Active execution time; time parked awaiting an approval does not count.
RUN_MAX_DURATION_MS=86400000
# How long an approval may stay pending before the run is abandoned (7 days).
RUN_APPROVAL_TIMEOUT_MS=604800000
